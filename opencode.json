{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "todowrite": "allow",
    "task": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git log*": "allow",
      "git diff*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git pull*": "allow",
      "git push*": "allow",
      "node *": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npx wrangler deploy*": "allow",
      "rm -rf *": "deny",
      "del /s*": "deny",
      "format *": "deny"
    }
  }
}
